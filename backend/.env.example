# Copy this file to backend/.env and fill in real values. Never commit the real .env.

# Set to "production" on the live server: missing required settings then stop the server
# instead of falling back to development defaults.
NODE_ENV=development
PORT=5050

# --- Frontend address (used in email links and for CORS) ---
# Where users open the app, without a trailing slash. Required when NODE_ENV=production.
FRONTEND_URL=http://localhost:3000
# Optional: more addresses allowed to call the API from a browser, comma-separated
# CORS_ORIGINS=https://second-domain.example.edu

# --- Rate limits for public routes that send email (per hour) ---
# Forgot password: emails per address (counted for unknown addresses too) and requests per IP.
# Register: attempts per IP. Over a forgot-password limit the reply is unchanged but no email
# is sent; over the register limit the reply is 429. Keep the per-IP limits generous: a whole
# campus (eduroam, computer labs) can share one IP.
RATE_LIMIT_FORGOT_PER_EMAIL=3
RATE_LIMIT_FORGOT_PER_IP=30
RATE_LIMIT_REGISTER_PER_IP=30

# Number of reverse proxies (e.g. nginx) in front of the backend, so the real client IP is used
# for the per-IP limits. 0 or empty = none (development). Must be a NUMBER such as 1, never
# "true": "true" would trust every X-Forwarded-For entry, which a client can fake to dodge limits.
TRUST_PROXY=0

# --- PostgreSQL ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=change-me
DB_NAME=credit_transfer

# --- MinIO (file storage) ---
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=change-me
MINIO_SECRET_KEY=change-me
# true when MinIO is served over HTTPS
MINIO_USE_SSL=false

# --- Login tokens ---
# Required. A long random string, e.g. the output of:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me

# --- Email (SMTP; Mailtrap sandbox in development) ---
EMAIL_HOST=sandbox.smtp.mailtrap.io
EMAIL_PORT=2525
EMAIL_USER=change-me
EMAIL_PASS=change-me
# Sender shown in emails. Use an address the SMTP account above is allowed to send from
# (normally the same mailbox/domain as EMAIL_USER), or mail servers may reject the email.
EMAIL_FROM="PTE Credit Transfer" <noreply@adminisztracio.pte.hu>
